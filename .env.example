# Twitch: not needed when signed in to Clipper. Your own app (optional): https://dev.twitch.tv/console/apps
# Your Twitch account needs two-factor auth on. Redirect URL: https://localhost. Category: Application Integration. Client type: Confidential.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Kick (optional): https://kick.com/settings/developer . Without it, discovery uses kick.com's public browse feed.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# AI hooks, trimming and Hinglish captions.
# Easiest: sign in to Clipper from the dashboard (Settings) and hooks run on Clipper Cloud.
# Unlimited and free instead: your own key below, or Ollama on this computer
#   brew install ollama && ollama pull qwen2.5:7b
# auto = your own key, then Clipper Cloud, then Ollama.
AI_PROVIDER=auto
OLLAMA_MODEL=qwen2.5:7b
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model overrides: ANTHROPIC_MODEL, OPENAI_MODEL, GROQ_MODEL, GEMINI_MODEL
# Any OpenAI-compatible server (LM Studio, vLLM, OpenRouter): set OPENAI_BASE_URL + AI_PROVIDER=openai

# Hindi captions: latin = Hinglish ("bhai kya hua"), devanagari = "भाई क्या हुआ"
HINDI_SCRIPT=latin

# Detection: higher = fewer, bigger moments. 2.6 means chat must run ~2.6x its normal speed.
SENSITIVITY=2.6
COOLDOWN_SECONDS=45
PRE_ROLL=22
POST_ROLL=6

# Recording quality (streamlink names, first available wins) and rolling buffer length
STREAM_QUALITY=720p60,720p,best
BUFFER_SECONDS=240

# Whisper model: tiny / base / small / medium / large-v3. small is a good balance on a Mac.
WHISPER_MODEL=small
CAPTION_LANGUAGE=

# Put the hook title at the top of non-split clips (1 = on)
SHOW_TITLE=1

# Clipper Cloud address. Default: https://apavin.com/api/clipper. Change only if you run your own server.
CLIPPER_CLOUD_URL=
